{
  "name": "@gabbe/pg-migrate",
  "version": "1.0.0",
  "description": "SQL-first PostgreSQL migration tool",
  "author": "gabts",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabts/pg-migrate.git"
  },
  "bugs": {
    "url": "https://github.com/gabts/pg-migrate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "database",
    "db",
    "migrate",
    "migration",
    "migrations",
    "migrator",
    "pg",
    "postgres",
    "postgresql",
    "programmatic",
    "sql"
  ],
  "files": [
    "bin/cli.js",
    "dist/**/*",
    "!dist/**/*.test.*",
    "!dist/**/*.d.ts.map"
  ],
  "bin": {
    "pg-migrate": "bin/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "build:watch": "tsc -w",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/pg": "^8.20.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
